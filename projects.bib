@misc{3dgs_sam2,
    title = {3D Semantic Segmentation with SAM2 Memory Bank},
    description = {We noticed that <a href="https://github.com/weijielyu/Gaga" target="_blank">GaGa</a> (Lyu et al.) repeatedly labeled the same objects when revisiting regions, especially textureless regions, such as walls, failing to maintain consistency across views. To address this, we leveraged the existing SAM2 memory bank and used our dense images and pose-based image warping to project previous masks onto new viewpoints. This simple approach enforced mask consistency in indoor scenes with "loop closure", reducing duplicate labeling especially in textureless regions.},
    img = {assets/img/project/3dgs_gaga.png},
    private = {true},
    video = {}, 
}

@misc{so101_keyboard_typer,
    title = {Keyboard-Typing SO-101},
    description = {Built an SO-101 robot arm that types on a real keyboard by looking at it. A camera and key detector locate keys, calibrated geometry estimates their 3D positions, and the arm uses inverse kinematics to hover, recheck, and press each key. Built on LeRobot with Atakan Topaloglu, Pelin Kincir, Samuel Sutanto, and Arda Cinar Demirtas.},
    img = {assets/img/project/so101_keyboard_typer.jpg},
    html = {https://github.com/atakan-topaloglu/so101-keyboard-typer},
}

